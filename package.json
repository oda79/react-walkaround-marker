{
  "name": "@oda79/react-walkaround-marker",
  "version": "0.1.0",
  "description": "A lightweight React canvas component for drawing and managing marks over vehicle walkaround images.",
  "license": "MIT",
  "author": "oda79",
  "repository": {
    "type": "git",
    "url": "https://github.com/oda79/react-walkaround-marker.git"
  },
  "homepage": "https://github.com/oda79/react-walkaround-marker#readme",
  "bugs": {
    "url": "https://github.com/oda79/react-walkaround-marker/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}